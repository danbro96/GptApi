# Copy to deploy/.env on the deploy host. compose.yaml reads these.

# REQUIRED: API key clients must present in X-API-Key (or ?api_key=).
# Generate with: openssl rand -hex 32
GPT_API_KEY=REPLACE_ME_64HEX
GPT_API_KEY_NAME=prod

# Image tag to pull. "latest" = main branch; pin to sha-XXXXXXX for reproducible deploys.
IMAGE_TAG=latest

# Public port the .NET gateway listens on. Workers are internal-only.
HOST_PORT=40480

# Fallback rate limit (requests/min, token bucket) for any key without its own quota. Set
# per-key budgets/priority directly on the Auth__ApiKeys__N entries in compose.yaml.
RATE_LIMIT=30

# Inference timeout (seconds) for the gateway-to-worker call. Covers a model load/swap on the
# first request plus generation; 300s leaves headroom for large CPU MoE loads.
REQUEST_TIMEOUT=300

# CORS: leave blank to disable, or set to your frontend origin (rare for an API-only service).
ALLOWED_ORIGIN=

# --- Workers (llama-swap + llama-server), split across hosts ---
#
# The gateway routes each request's `model` to a backend (see Llama__Routes in compose.yaml):
#   gpu    → a remote GPU host, reached by GPU_WORKER_URL — heavy workhorse + CPU heavy tier.
#   nasGpu → gpt-worker-a380 (a local GPU, Vulkan) — encoders.
#   nasCpu → gpt-worker (CPU) — triage + workhorse/encoder fallback + the top CPU tier.
#
# Per-host model lists / GGUF filenames / flags live in the deploy/llama-swap*.yaml files
# (gpu = the GPU host, a380 = the local GPU encoders, plain = CPU). This .env has no model knobs.

# Remote GPU host worker URL (LAN). The router fails workhorse requests over to the CPU worker
# when this is unreachable (host offline). Give the host a stable address (DHCP reservation/DNS).
GPU_WORKER_URL=http://gpu-host:9000

# Image for the local GPU encoder worker — must bundle a Vulkan (or SYCL) llama-server build.
GPU_ENCODER_IMAGE=ghcr.io/mostlygeek/llama-swap:vulkan

# Bind-mount sources (GGUF cache + the per-host llama-swap configs).
CACHE_DIR=./cache
CPU_CONFIG=./llama-swap.yaml
ENCODER_CONFIG=./llama-swap.a380.yaml

# OpenTelemetry. Leave blank to disable; otherwise point at your OTLP collector.
# When OTEL_EXPORTER_OTLP_ENDPOINT is empty the .NET service skips OTel setup entirely.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=prod
TELEMETRY_NETWORK=telemetry
