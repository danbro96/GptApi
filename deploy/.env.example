# Copy to deploy/.env on the deploy host. compose.yaml reads these.

# REQUIRED: API key clients must present in X-API-Key (or ?api_key=).
# Generate with: openssl rand -hex 32
GPT_API_KEY=REPLACE_ME_64HEX
GPT_API_KEY_NAME=prod

# Image tag to pull. "latest" = main branch; pin to sha-XXXXXXX for reproducible deploys.
IMAGE_TAG=latest

# Public port the .NET service listens on. Worker is internal-only.
HOST_PORT=40480

# Per-key rate limit (requests per minute, token bucket).
RATE_LIMIT=30

# Inference timeout in seconds for the .NET-to-worker call.
# Qwen3.6-35B-A3B is MoE (3B active params/token) so generations are surprisingly
# fast on the Xeon, but 300s (5 min) still leaves comfortable headroom.
REQUEST_TIMEOUT=300

# CORS: leave blank to disable, or set to your frontend origin (rare for an API-only service).
ALLOWED_ORIGIN=

# --- Worker (llama.cpp/llama-server) ---

# Filename of the GGUF inside /cache (host: /mnt/tank2/appdata/gpt_api/cache/).
# Stage the file there manually; see deployment guide.
# Default: Qwen3.6-35B-A3B (MoE, 3B active params/token), Unsloth Dynamic Q8 (~38.5 GB).
MODEL_FILE=Qwen3.6-35B-A3B-UD-Q8_K_XL.gguf

# The model id reported via /v1/models. Clients reference this in their requests.
SERVED_MODEL_ID=qwen3.6-35b-a3b

# Context window size in tokens.
CONTEXT_SIZE=8192

# Threads — match physical core count on the Xeon Gold 6248 (20 cores).
THREADS=20

# OpenTelemetry. Leave blank to disable; otherwise point at the OpenObserve collector.
# When OTEL_EXPORTER_OTLP_ENDPOINT is empty the .NET service skips OTel setup entirely.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=prod,host.name=medelynas
